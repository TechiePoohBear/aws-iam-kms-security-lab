{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProdReadOnlyHTTPS",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::prod-bucket-environment",
        "arn:aws:s3:::prod-bucket-environment/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "ListBucketsForConsole",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "DevFullAccess",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::dev-bucket-<ACCOUNT-ID>-us-east-1",
        "arn:aws:s3:::dev-bucket-<ACCOUNT-ID>-us-east-1/*"
      ]
    }
  ]
}
